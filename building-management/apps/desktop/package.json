{
  "name": "@bm/desktop",
  "version": "0.0.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "co.il.buildingmanagement.desktop",
    "productName": "ניהול מבנים",
