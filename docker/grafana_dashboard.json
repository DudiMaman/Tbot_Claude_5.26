{
  "title": "Trading Bot",
  "uid": "tradingbot-main",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "panels": [
    {
      "id": 10,
      "title": "Bot Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "LIVE", "color": "green" } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{ "expr": "up{job=~\".*trading.*|.*bot.*\"}", "legendFormat": "Status", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" }
    },
    {
      "id": 11,
      "title": "Last Heartbeat",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 120 }] },
          "color": { "mode": "thresholds" },
          "displayName": "Since last bar"
        }
      },
      "targets": [{ "expr": "time() - trading_heartbeat_timestamp", "legendFormat": "Heartbeat age", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 2,
      "title": "Daily P&L",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{ "expr": "trading_daily_pnl_usd", "legendFormat": "Day P&L", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "Open Positions",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 3, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "targets": [{ "expr": "sum(trading_open_positions)", "legendFormat": "Positions", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Total Fills",
      "type": "stat",
      "gridPos": { "x": 15, "y": 0, "w": 3, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#5794F2" }
        }
      },
      "targets": [{ "expr": "sum(trading_fills_total)", "legendFormat": "Fills", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Fills — Buy vs Sell",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 3 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "buy" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "sell" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        { "expr": "trading_fills_total{side=\"buy\"}", "legendFormat": "buy", "refId": "A" },
        { "expr": "trading_fills_total{side=\"sell\"}", "legendFormat": "sell", "refId": "B" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "orientation": "horizontal" }
    },
    {
      "id": 1,
      "title": "Equity (USD)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "targets": [{ "expr": "trading_equity_usd", "legendFormat": "Equity", "refId": "A" }],
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 6,
      "title": "Fills per minute",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "bars" }
        }
      },
      "targets": [{ "expr": "rate(trading_fills_total[5m]) * 60", "legendFormat": "{{side}}", "refId": "A" }]
    },
    {
      "id": 7,
      "title": "Signal Rejections by Reason",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "sort_desc(trading_rejections_total)", "legendFormat": "{{reason}}", "refId": "A" }],
      "options": { "xTickLabelRotation": -30 }
    },
    {
      "id": 8,
      "title": "Trade Log  (fill_processed events)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 10 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [{
        "expr": "{container=\"docker-bot-1\"} | json | event=`fill_processed`",
        "legendFormat": "",
        "refId": "A"
      }]
    }
  ],
  "schemaVersion": 38
}
