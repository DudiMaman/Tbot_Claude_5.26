{
  "title": "Trading Bot",
  "uid": "tradingbot-main",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "tags": ["trading", "bot"],
  "style": "dark",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "infinity_ds",
        "type": "datasource",
        "label": "Bot API (Infinity)",
        "query": "yesoreyeram-infinity-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "bot_api",
        "type": "textbox",
        "label": "Bot API URL",
        "description": "Reach the bot's port 8001 — http://localhost:8001 for local Grafana, http://bot:8001 for same-Docker-network, or http://<VM_PUBLIC_IP>:8001 for Grafana Cloud.",
        "query": "http://localhost:8001",
        "current": { "text": "http://localhost:8001", "value": "http://localhost:8001" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Portfolio Equity",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "description": "Current portfolio value (cash + open positions).",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "custom": { "lineWidth": 2, "fillOpacity": 25, "gradientMode": "opacity" }
        }
      },
      "targets": [{ "expr": "trading_equity_usd", "legendFormat": "Equity", "refId": "A" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "title": "Total Return",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "description": "Equity − starting capital. The lifetime P&L on your deposit.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#E02F44", "value": null },
            { "color": "#73BF69", "value": 0 }
          ]},
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity" }
        }
      },
      "targets": [{ "expr": "sum(trading_equity_usd) - sum(trading_initial_capital_usd)", "legendFormat": "Return", "refId": "A" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "Total Return %",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "description": "Lifetime return on starting capital. Target: ≥ +12%/mo.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#E02F44", "value": null },
            { "color": "#FF9830", "value": 0 },
            { "color": "#73BF69", "value": 12 }
          ]},
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity" }
        }
      },
      "targets": [{ "expr": "(sum(trading_equity_usd) - sum(trading_initial_capital_usd)) / sum(trading_initial_capital_usd) * 100", "legendFormat": "Return %", "refId": "A" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },

    {
      "id": 10,
      "title": "Bot",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 5, "w": 4, "h": 3 },
      "description": "Green = bar processed in last 30s. Orange = 30–120s. Red = >120s (dead).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "range", "options": { "from": 0, "to": 30, "result": { "text": "LIVE", "color": "green" } } },
            { "type": "range", "options": { "from": 30, "to": 120, "result": { "text": "SLOW", "color": "orange" } } },
            { "type": "range", "options": { "from": 120, "to": 9999999, "result": { "text": "DOWN", "color": "red" } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "DOWN", "color": "red" } } }
          ],
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 0 },
            { "color": "orange", "value": 30 },
            { "color": "red", "value": 120 }
          ]}
        }
      },
      "targets": [{ "expr": "time() - trading_heartbeat_timestamp", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background_solid", "textMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 11,
      "title": "Safety Breaker",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 4, "y": 5, "w": 8, "h": 3 },
      "description": "0=normal · 1=defensive · 2=streak halt · 3=daily loss breach (paused until UTC midnight).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NORMAL", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "DEFENSIVE", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "STREAK HALT", "color": "red" } } },
            { "type": "value", "options": { "3": { "text": "DAILY LOSS BREACH", "color": "red" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 2 }
          ]}
        }
      },
      "targets": [{ "expr": "trading_breaker_state", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background_solid", "textMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 12,
      "title": "Open Positions",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 5, "w": 4, "h": 3 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "#5794F2" } }
      },
      "targets": [{ "expr": "sum(trading_open_positions)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 13,
      "title": "Daily P&L",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 5, "w": 4, "h": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#E02F44", "value": null },
            { "color": "#73BF69", "value": 0 }
          ]}
        }
      },
      "targets": [{ "expr": "trading_daily_pnl_usd", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "value", "graphMode": "area", "justifyMode": "center" }
    },
    {
      "id": 14,
      "title": "Streak Losses",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 20, "y": 5, "w": 4, "h": 3 },
      "description": "Defensive mode kicks in at the configured threshold; full halt at the higher one.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 5 },
            { "color": "red", "value": 10 }
          ]}
        }
      },
      "targets": [{ "expr": "trading_consecutive_losses", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "value", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "id": 20,
      "title": "Win Rate",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "description": "Wins / closed trades. Trend strategies often run 10–25% with high R:R.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#E02F44", "value": null },
            { "color": "#FF9830", "value": 15 },
            { "color": "#73BF69", "value": 30 }
          ]}
        }
      },
      "targets": [{ "expr": "trading_win_rate_pct", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true, "orientation": "auto" }
    },
    {
      "id": 21,
      "title": "Profit Factor",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "description": "Σ wins / |Σ losses|. >1 profitable · >1.5 healthy · >2 excellent.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 3,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#E02F44", "value": null },
            { "color": "#FF9830", "value": 1 },
            { "color": "#73BF69", "value": 1.5 }
          ]}
        }
      },
      "targets": [{ "expr": "trading_profit_factor", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true, "orientation": "auto" }
    },
    {
      "id": 22,
      "title": "Max Drawdown",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 },
      "description": "Largest peak-to-trough drop. Lower is better.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 20,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#73BF69", "value": null },
            { "color": "#FF9830", "value": 5 },
            { "color": "#E02F44", "value": 10 }
          ]}
        }
      },
      "targets": [{ "expr": "trading_max_drawdown_pct", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true, "orientation": "auto" }
    },
    {
      "id": 23,
      "title": "Closed Trades · Total Fees",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 6 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "#5794F2" } },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [
            { "id": "unit", "value": "currencyUSD" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "#A352CC" } }
          ]}
        ]
      },
      "targets": [
        { "expr": "trading_closed_trades_total", "legendFormat": "Closed Trades", "refId": "A" },
        { "expr": "trading_total_fees_usd", "legendFormat": "Total Fees", "refId": "B" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "value_and_name",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical"
      }
    },

    {
      "id": 30,
      "title": "Equity",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 9 },
      "description": "Live equity vs starting capital (dashed reference).",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "showPoints": "never",
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Starting Capital" }, "properties": [
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8E8E8E" } },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
            { "id": "custom.fillOpacity", "value": 0 }
          ]},
          { "matcher": { "id": "byName", "options": "Equity" }, "properties": [
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }
          ]}
        ]
      },
      "targets": [
        { "expr": "trading_equity_usd", "legendFormat": "Equity", "refId": "A" },
        { "expr": "trading_initial_capital_usd", "legendFormat": "Starting Capital", "refId": "B" }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] }
      }
    },

    {
      "id": 40,
      "title": "Fills per minute",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 60, "drawStyle": "bars", "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "buy" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }] },
          { "matcher": { "id": "byName", "options": "sell" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E02F44" } }] }
        ]
      },
      "targets": [{ "expr": "rate(trading_fills_total[5m]) * 60", "legendFormat": "{{side}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 41,
      "title": "Signal Rejections by Reason",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 7 },
      "description": "Why the risk manager turned signals away.",
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [{ "expr": "sort_desc(trading_rejections_total)", "legendFormat": "{{reason}}", "refId": "A" }],
      "options": { "xTickLabelRotation": -20, "legend": { "displayMode": "list", "placement": "bottom" }, "stacking": "none" }
    },

    {
      "id": 50,
      "title": "Per-Symbol Performance",
      "type": "table",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity_ds}" },
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 },
      "description": "Closed-trade breakdown by symbol.",
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Net P&L" }, "properties": [
            { "id": "unit", "value": "currencyUSD" },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#E02F44", "value": null }, { "color": "#73BF69", "value": 0 }] } }
          ]},
          { "matcher": { "id": "byName", "options": "Fees" }, "properties": [{ "id": "unit", "value": "currencyUSD" }] },
          { "matcher": { "id": "byName", "options": "Win Rate" }, "properties": [{ "id": "unit", "value": "percent" }] },
          { "matcher": { "id": "byName", "options": "PF" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#E02F44", "value": null }, { "color": "#FF9830", "value": 1 }, { "color": "#73BF69", "value": 1.5 }] } }
          ]}
        ]
      },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "url": "${bot_api}/symbol_stats",
        "url_options": { "method": "GET" },
        "columns": [
          { "selector": "symbol", "text": "Symbol", "type": "string" },
          { "selector": "trades", "text": "Trades", "type": "number" },
          { "selector": "win_rate_pct", "text": "Win Rate", "type": "number" },
          { "selector": "profit_factor", "text": "PF", "type": "number" },
          { "selector": "net_pnl", "text": "Net P&L", "type": "number" },
          { "selector": "fees", "text": "Fees", "type": "number" }
        ]
      }],
      "options": { "sortBy": [{ "displayName": "Net P&L", "desc": true }] }
    },

    {
      "id": 60,
      "title": "Trade History",
      "type": "table",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity_ds}" },
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 12 },
      "description": "Newest first. Color shows win/loss.",
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Net P&L" }, "properties": [
            { "id": "unit", "value": "currencyUSD" },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#E02F44", "value": null }, { "color": "#73BF69", "value": 0 }] } }
          ]},
          { "matcher": { "id": "byName", "options": "Result" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "win": { "color": "#73BF69", "text": "WIN" } } },
              { "type": "value", "options": { "loss": { "color": "#E02F44", "text": "LOSS" } } }
            ]}
          ]},
          { "matcher": { "id": "byName", "options": "Gross P&L" }, "properties": [{ "id": "unit", "value": "currencyUSD" }] },
          { "matcher": { "id": "byName", "options": "Fees" }, "properties": [{ "id": "unit", "value": "currencyUSD" }] },
          { "matcher": { "id": "byName", "options": "Entry" }, "properties": [{ "id": "decimals", "value": 6 }] },
          { "matcher": { "id": "byName", "options": "Exit" }, "properties": [{ "id": "decimals", "value": 6 }] },
          { "matcher": { "id": "byName", "options": "Duration" }, "properties": [{ "id": "unit", "value": "m" }] }
        ]
      },
      "targets": [{
        "refId": "A",
        "type": "json",
        "source": "url",
        "url": "${bot_api}/trades",
        "url_options": { "method": "GET" },
        "columns": [
          { "selector": "time", "text": "Time", "type": "timestamp" },
          { "selector": "symbol", "text": "Symbol", "type": "string" },
          { "selector": "side", "text": "Side", "type": "string" },
          { "selector": "entry_price", "text": "Entry", "type": "number" },
          { "selector": "exit_price", "text": "Exit", "type": "number" },
          { "selector": "qty", "text": "Qty", "type": "number" },
          { "selector": "gross_pnl", "text": "Gross P&L", "type": "number" },
          { "selector": "fees", "text": "Fees", "type": "number" },
          { "selector": "net_pnl", "text": "Net P&L", "type": "number" },
          { "selector": "duration_min", "text": "Duration", "type": "number" },
          { "selector": "result", "text": "Result", "type": "string" }
        ]
      }],
      "options": { "sortBy": [{ "displayName": "Time", "desc": true }] }
    }
  ],
  "schemaVersion": 38
}
